#!/usr/bin/env bash
# shellcheck disable=SC2034  # variables are consumed by setup.sh

########################################
# GIMP Setup configuration
#
# Copy this file to config.sh and fill in
# your values. config.sh is gitignored.
#
# Every value falls back to an environment
# variable of the same name, so a parent
# script (for example, linux-mint-setup)
# can export these instead of shipping a
# config.sh.
########################################

#
# Address of the ComfyUI server used by the AI tools.
#
# The local ComfyUI (FLUX.2 klein, Qwen-Image-Edit and SAM 2.1, fully
# local, no account or key) is installed by linux-mint-setup
# (steps/comfyui) as the `comfyui` user service; leave this empty to use
# that service's address (or ComfyUI's default address on this machine
# when there is none). Set it to use a ComfyUI running elsewhere; see
# docs/AI_PLUGINS.md for the model files it needs.
#
# The setup saves it to ~/.config/PhotoGIMP/comfyui-url (host and Flatpak
# sandbox copies); Filters > AI > Settings can still override it.
#
COMFYUI_URL="${COMFYUI_URL:-}"

#
# Photoshop text language for the PSD editable-text plug-in
# (features/psd-text.sh): written to the Type layers of an exported PSD
# whose GIMP text layer has no language of its own. It drives Photoshop's
# spell check and hyphenation (Character panel > language).
#
# en-us (default), pt-br, pt, or an Adobe text engine code number.
#
PSD_TEXT_LANGUAGE="${PSD_TEXT_LANGUAGE:-en-us}"

#
# Start ComfyUI together with GIMP (features/comfyui-with-gimp.sh): the GIMP
# menu entry starts the `comfyui` service, and closing GIMP stops it again
# (only when it was the launcher that started it). Needs the `comfyui`
# service from linux-mint-setup.
# "no" restores the plain GIMP launcher; then start ComfyUI by hand.
#
COMFYUI_START_WITH_GIMP="${COMFYUI_START_WITH_GIMP:-yes}"
