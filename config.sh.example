#!/usr/bin/env bash
# shellcheck disable=SC2034  # variables are consumed by setup.sh

########################################
# GIMP Setup configuration
#
# Copy this file to config.sh and fill in
# your values. config.sh is gitignored.
#
# Every value falls back to an environment
# variable of the same name, so a parent
# script (for example, linux-mint-setup)
# can export these instead of shipping a
# config.sh.
########################################

#
# Address of the WithoutBG server used by the WithoutBG plug-in
# (Tools > WithoutBG > Remove Background).
#
# Point it at your own self-hosted instance, or leave the default to use a
# WithoutBG server running locally (Docker or the Mac app).
#
# The setup saves it to ~/.config/PhotoGIMP/withoutbg-server-url (host and
# Flatpak sandbox copies); the plug-in dialog can still override it per run.
#
WITHOUTBG_SERVER_URL="${WITHOUTBG_SERVER_URL:-http://127.0.0.1:8000}"

#
# ComfyUI, the local AI models behind GIMP's AI tools
# (Filters > AI > Remove Selection / Generative Fill / Image Generator:
# FLUX.2 klein or Qwen-Image-Edit, fully local, no account or key).
#
# COMFYUI_DIR is where ComfyUI, its Python environment and its models are
# installed, e.g. a directory on a larger data disk: the models are tens of
# GB and the feature wants about 45 GB free. Needs an NVIDIA GPU with its
# driver installed (a 6 GB card is enough; what does not fit is kept in RAM).
#
# Leave empty to skip installing ComfyUI (the AI tools then need a ComfyUI
# you run yourself, at COMFYUI_URL).
#
COMFYUI_DIR="${COMFYUI_DIR:-}"

#
# Which model sets to download, comma separated (see
# assets/comfyui/models.tsv):
#
#   qwen  - Qwen-Image-Edit-2511, ~22 GB. Best quality;
#           what comic-skills uses to erase text over art.
#   klein - FLUX.2 klein 4B, ~12 GB. Faster, lower quality;
#           the only one that generates images from text.
#   sam   - SAM 2.1 large, ~450 MB. Segment Anything, for
#           Select > Object Selection (AI) / Subject (AI).
#
# All three by default. Leave empty to install ComfyUI without any model.
#
COMFYUI_MODEL_SETS="${COMFYUI_MODEL_SETS-qwen,klein,sam}"

#
# Port the ComfyUI user service listens on (127.0.0.1 only).
#
COMFYUI_PORT="${COMFYUI_PORT:-8188}"

#
# Where ComfyUI, its GGUF node and PyTorch come from. The defaults are the
# upstream repositories and the CUDA 12.8 build of PyTorch; override to use
# a fork or another CUDA version.
#
COMFYUI_REPO="${COMFYUI_REPO:-https://github.com/comfyanonymous/ComfyUI.git}"
COMFYUI_GGUF_NODE_REPO="${COMFYUI_GGUF_NODE_REPO:-https://github.com/city96/ComfyUI-GGUF.git}"
COMFYUI_TORCH_INDEX_URL="${COMFYUI_TORCH_INDEX_URL:-https://download.pytorch.org/whl/cu128}"

#
# Address of the ComfyUI server used by the AI tools.
#
# Leave empty to use http://127.0.0.1:COMFYUI_PORT when COMFYUI_DIR is set,
# or ComfyUI's default address on this machine otherwise. ComfyUI must be
# running when the tools are used (`systemctl --user start comfyui`); see
# docs/AI_PLUGINS.md for the model files it needs.
#
# The setup saves it to ~/.config/PhotoGIMP/comfyui-url (host and Flatpak
# sandbox copies); Filters > AI > Settings can still override it.
#
COMFYUI_URL="${COMFYUI_URL:-}"

#
# Photoshop text language for the PSD editable-text plug-in
# (features/psd-text.sh): written to the Type layers of an exported PSD
# whose GIMP text layer has no language of its own. It drives Photoshop's
# spell check and hyphenation (Character panel > language).
#
# en-us (default), pt-br, pt, or an Adobe text engine code number.
#
PSD_TEXT_LANGUAGE="${PSD_TEXT_LANGUAGE:-en-us}"

#
# Start ComfyUI together with GIMP (features/comfyui-with-gimp.sh): the GIMP
# menu entry starts the `comfyui` service, and closing GIMP stops it again
# (only when it was the launcher that started it). Needs COMFYUI_DIR.
# "no" restores the plain GIMP launcher; then start ComfyUI by hand.
#
COMFYUI_START_WITH_GIMP="${COMFYUI_START_WITH_GIMP:-yes}"
